# Copy to .env / .env.local and fill in. Validated by src/shared/schemas/env.ts.
# Never commit real values.

# Supabase (Phase 1: Auth + Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM inference (provider-abstracted behind ModelProvider; see
# src/application/experience-selection/). Vercel AI Gateway is the
# default seam; nothing here hard-codes a model vendor.
AI_GATEWAY_API_KEY=

# Semantic memory / retrieval (Phase 4). Not a source of truth.
SUPERMEMORY_API_KEY=
